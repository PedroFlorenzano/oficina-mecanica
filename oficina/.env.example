# ============================================================
# PostgreSQL — Banco de dados
# ============================================================

# Conexão principal (com pooling) — usada pela aplicação em runtime
DATABASE_URL="postgresql://neondb_owner:SENHA@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Conexão direta (sem pooling) — usada pelo Prisma para migrations
DIRECT_URL="postgresql://neondb_owner:SENHA@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Admin_Role — BYPASSRLS — uso EXCLUSIVO em operações cross-tenant (dev local)
# Em produção no Neon, usar a mesma DATABASE_URL (owner já tem BYPASSRLS)
DATABASE_URL_ADMIN="postgresql://neondb_owner:SENHA@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# NextAuth
# ============================================================
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# Evolution API (WhatsApp)
# ============================================================
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# ============================================================
# Cron (lembrete preventivo)
# ============================================================
CRON_SECRET=""

# ============================================================
# Cloudflare Turnstile (captcha gratuito) — protege /register e agendamento público
# Sem estas variáveis o captcha é simplesmente ignorado (dev/CI seguem funcionando).
# Chaves em: https://dash.cloudflare.com → Turnstile → Add site
# ============================================================
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ============================================================
# Cloudinary — armazenamento das fotos da OS
# ============================================================
# Necessário em produção: o filesystem da Vercel é somente-leitura, então salvar
# foto em disco falha. Sem estas variáveis a aplicação grava em ./uploads, o que
# serve para desenvolvimento e para o CI.
#
# Onde obter: https://console.cloudinary.com → Dashboard → API Keys
# O plano gratuito não pede cartão de crédito.
#
# ATENÇÃO: as três são segredos de servidor. Nenhuma delas leva o prefixo
# NEXT_PUBLIC_, que exporia o valor no JavaScript enviado ao navegador.
#
# As imagens são enviadas com type=authenticated, ou seja, não ficam acessíveis
# por URL adivinhável. Quem serve a foto é /api/uploads, que valida a sessão e
# o tenant antes de devolver os bytes.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
